{
  "name": "nowmobile",
  "version": "0.0.1",
  "description": "NOWnews mobile service",
  "main": "index.js",
  "scripts": {
    "mobile:dev.build": "npm run mobile:clean && ./node_modules/gulp/bin/gulp.js --gulpfile ./mobile_web/gulpfile.js dev:build",
    "start": "npm install && npm run mobile:dev.build && NODE_ENV=staging DEBUG=NOWmobile* ./node_modules/nodemon/bin/nodemon.js ./bin/mobile_web.js",
    "admin": "DEBUG=NOWmobile* && npm install && NODE_ENV=staging ./node_modules/nodemon/bin/nodemon.js ./bin/admin.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mobile:clean": "./node_modules/gulp/bin/gulp.js --gulpfile ./mobile_web/gulpfile.prod.js clean",
    "mobile:prod.build": "npm run mobile:clean && ./node_modules/gulp/bin/gulp.js  --gulpfile ./mobile_web/gulpfile.prod.js build:prod",
    "mobile:prod": "npm install && npm run mobile:prod.build && ./node_modules/nodemon/bin/nodemon.js ./bin/mobile_web.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/nownews/NOWmobile.git"
  },
  "author": "Webber Wu",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/nownews/NOWmobile/issues"
  },
  "homepage": "https://gitlab.com/nownews/NOWmobile#README",
  "dependencies": {
    "babel-core": "^6.9.1",
    "babel-polyfill": "^6.9.1",
    "babel-preset-es2015": "^6.9.0",
    "babel-preset-stage-0": "^6.5.0",
    "bluebird": "^3.4.1",
    "body-parser": "^1.15.2",
    "bower": "^1.7.9",
    "co": "^4.6.0",
    "compression": "^1.6.2",
    "cookie-parser": "^1.4.3",
    "cookie-session": "^2.0.0-alpha.1",
    "cors": "^2.7.1",
    "debug": "^2.2.0",
    "express": "^4.13.4",
    "is_js": "^0.8.0",
    "lodash": "^4.13.1",
    "md5": "^2.1.0",
    "method-override": "^2.3.6",
    "moment-timezone": "^0.5.4",
    "mongodb": "^2.1.21",
    "mongoose": "^4.5.2",
    "mongoose-auto-increment": "^5.0.1",
    "morgan": "^1.7.0",
    "node-fetch": "^1.5.3",
