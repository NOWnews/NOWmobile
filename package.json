{
  "name": "nowmobile",
  "version": "1.1.15",
  "description": "NOWnews mobile service",
  "main": "index.js",
  "scripts": {
    "start": "npm install && NODE_ENV=develop DEBUG=NOWmobile* ./node_modules/nodemon/bin/nodemon.js ./bin/mobile_web.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "./node_modules/gulp/bin/gulp.js --gulpfile ./mobile_web/gulpfile.js clean",
    "build": "npm run clean && ./node_modules/gulp/bin/gulp.js  --gulpfile ./mobile_web/gulpfile.js build:prod",
    "prod": "npm install && npm run build && NODE_ENV=production ./node_modules/nodemon/bin/nodemon.js ./bin/mobile_web.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/nownews/NOWmobile.git"
  },
  "author": "Webber Wu",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/nownews/NOWmobile/issues"
  },
  "homepage": "https://gitlab.com/nownews/NOWmobile#README",
  "dependencies": {
    "babel-core": "6.26.0",
    "babel-polyfill": "6.26.0",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-stage-0": "6.24.1",
    "bluebird": "3.5.1",
    "body-parser": "1.18.2",
    "bower": "1.8.2",
    "chalk": "2.3.0",
    "chinese-conv": "1.0.1",
    "compression": "1.7.1",
    "config": "1.27.0",
    "cookie-parser": "1.4.3",
    "cookie-session": "2.0.0-beta.3",
    "cors": "2.8.4",
    "debug": "3.1.0",
    "express": "4.16.2",
    "geoip-lite": "1.2.1",
    "iconv-lite": "0.4.19",
    "is_js": "0.9.0",
    "lodash": "4.17.4",
    "md5": "2.2.1",
    "method-override": "2.3.10",
    "moment-timezone": "0.5.13",
    "morgan": "1.9.0",
    "node-fetch": "1.7.3",
    "nodemon": "1.12.1",
    "nunjucks": "3.0.1",
    "sitemap": "1.13.0"
  },
