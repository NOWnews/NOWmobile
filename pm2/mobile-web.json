{
  "apps" : [{
    "name"        : "mobile-web",
    "script"      : "./bin/mobile_web.js",
    "watch"       : false,
    "env": {
      "NODE_ENV": "develop"
    },
    "env_china" : {
      "NODE_ENV": "china"
    },
    "env_staging" : {
      "NODE_ENV": "staging"
    },
    "env_production" : {
      "NODE_ENV": "production"
    },
    "instances"  : 0,
    "exec_mode"  : "cluster",
    "log_date_format" : "YYYY-MM-DD HH:mm Z",
    "out_file": "/dev/null"
  }]
}